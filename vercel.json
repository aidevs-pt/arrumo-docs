{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/tools/arrumo/docs/user/tutorial",
      "destination": "https://www.aidevs.pt/tools/arrumo/docs/user/tutorials/website-to-video",
      "permanent": true
    },
    {
      "source": "/:lang(es|pt)/tools/arrumo/docs/user/tutorial",
      "destination": "https://www.aidevs.pt/:lang/tools/arrumo/docs/user/tutorials/website-to-video",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/en/tools/arrumo/docs/index.md",
      "destination": "/tools/arrumo/static/md/tools/arrumo/docs.md"
    },
    {
      "source": "/:lang(es|pt)/tools/arrumo/docs/index.md",
      "destination": "/tools/arrumo/static/md/:lang/tools/arrumo/docs.md"
    },
    {
      "source": "/en/tools/arrumo/docs/(.+)\\.(md|txt)",
      "destination": "/tools/arrumo/static/md/tools/arrumo/docs/$1.$2"
    },
    {
      "source": "/(es|pt)/tools/arrumo/docs/(.+)\\.(md|txt)",
      "destination": "/tools/arrumo/static/md/$1/tools/arrumo/docs/$2.$3"
    },
    {
      "source": "/",
      "destination": "/en/tools/arrumo/docs"
    },
    {
      "source": "/tools/arrumo/docs",
      "destination": "/en/tools/arrumo/docs"
    },
    {
      "source": "/tools/arrumo/docs/:path*",
      "destination": "/en/tools/arrumo/docs/:path*"
    },
    {
      "source": "/tools/arrumo/static/_next/:path*",
      "destination": "/_next/:path*"
    }
  ]
}
